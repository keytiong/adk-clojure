{:paths
 ["src/main/clojure" "src/main/java" "target/classes"]

 :deps
 {org.clojure/clojure                 {:mvn/version "1.12.3"}
  org.clojure/core.async              {:mvn/version "1.9.808-alpha1"}
  org.clojure/tools.logging           {:mvn/version "1.3.0"}
  com.google.adk/google-adk           {:mvn/version "0.3.0"}
  com.cnuernber/charred               {:mvn/version "1.037"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}}

 :deps/prep-lib {:alias  :build
                 :fn     compile-java
                 :ensure "target/classes"}

 :aliases
 {:build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
   :ns-default build}

  :deploy
  {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}
   :exec-fn    deps-deploy.deps-deploy/deploy
   :exec-args  {:installer      :remote
                :sign-releases? true
                :pom-file       "target/classes/META-INF/maven/io.kosong.adk/adk-clojure/pom.xml"
                :artifact       "target/adk-clojure-0.1.0-SNAPSHOT.jar"}}}}